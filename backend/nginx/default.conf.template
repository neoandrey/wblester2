# WBLESTER admin SPA reverse proxy.
# Serves the Flutter admin bundle from the image at /admin/* and forwards
# everything else (JSON API, public website, uploads) to the webapi service,
# keeping the whole app on a single origin so no CORS config is needed.
#
# This file is a template: the official nginx image runs envsubst over
# /etc/nginx/templates/*.template at boot, so ${WBLESTER_API_PORT} (set by
# docker-compose from $PORT) picks the webapi upstream port. Other $variables
# below are nginx runtime ones ($uri, $host, ...) and are not env vars, so
# envsubst leaves them untouched.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json
               application/wasm image/svg+xml;
    gzip_min_length 512;

    # Serve /admin and /admin/ without an external redirect: Chrome (headless
    # included) balked at following nginx's 301 here, and the index module's
    # own directory slash-redirect has the same effect, so the bare /admin
    # path is folded into the trailing-slash form with an internal rewrite.
    location = /admin {
        rewrite ^ /admin/ last;
    }

    location ^~ /admin {
        alias /usr/share/nginx/html/admin/;
        index index.html;
        try_files $uri $uri/ /admin/index.html;
    }

    location / {
        proxy_pass http://webapi:${WBLESTER_API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}